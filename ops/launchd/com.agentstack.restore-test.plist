<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.agentstack.restore-test</string>

    <!-- The backup is not the thing. The restore is. This job exists because
         an untested backup is a hope, and hopes do not survive a failed SSD. -->
    <key>ProgramArguments</key>
    <array>
        <string>/opt/agentstack/ops/bin/restore-test.sh</string>
    </array>

    <key>StartCalendarInterval</key>
    <dict>
        <key>Weekday</key><integer>0</integer>
        <key>Hour</key><integer>5</integer>
        <key>Minute</key><integer>0</integer>
    </dict>

    <key>ProcessType</key>
    <string>Background</string>
    <key>StandardOutPath</key>
    <string>/opt/agentstack/logs/restore-test.log</string>
    <key>StandardErrorPath</key>
    <string>/opt/agentstack/logs/restore-test.log</string>
</dict>
</plist>
