# Microsoft Graph (delegated) — from IT admin
MICROSOFT_CLIENT_ID=[CLIENT_ID]
MICROSOFT_CLIENT_SECRET=[CLIENT_SECRET]
MICROSOFT_TENANT_ID=[TENANT_ID]
MICROSOFT_REDIRECT_URI=[LOCAL_FOR_DEV_OR_N8N_CALLBACK_FOR_PROD]

# Anthropic
ANTHROPIC_API_KEY=[API_KEY]

# Companies House (free key)
COMPANIES_HOUSE_API_KEY=[CH_KEY]

# Teams via Power Automate Workflow
TEAMS_WORKFLOW_URL=[POWER_AUTOMATE_WORKFLOW_URL]

# User identity (AI signature)
USER_NAME=[FULL_NAME]
USER_PHONE=[PHONE]
USER_EMAIL=[EMAIL]
USER_TIMEZONE=Europe/London

# Scoring target
SCORING_TARGET_COMPANY=Eagle Eye Innovations
SCORING_TARGET_DOMAIN=eeinnovationsltd.com
SCORING_TARGET_CH_NUMBER=08631843

# OAuth token cache (delegated refresh token persisted here after `npm run auth`).
# For local dev only — in n8n Cloud the Microsoft 365 credential handles token storage.
GRAPH_TOKEN_CACHE=.graph-token-cache.json
