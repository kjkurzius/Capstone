{
  "name": "ai-exec-assistant",
  "version": "1.0.0",
  "private": true,
  "description": "AI Executive Assistant: Outlook triage + draft-then-approve replies and a deterministic daily Opportunity Score for Eagle Eye Innovations. Code runs locally for dev; production runs in n8n Cloud.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "score": "tsx src/scoring/opportunity-score.ts",
    "auth": "tsx src/utils/graph-client.ts --auth",
    "test:graph": "tsx src/utils/graph-client.ts --whoami",
    "typecheck": "tsc --noEmit",
    "build": "tsc"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.69.0",
    "dotenv": "^16.4.5"
  },
  "devDependencies": {
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "@types/node": "^22.9.0"
  }
}
