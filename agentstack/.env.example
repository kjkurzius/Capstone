# Reflex plane
JEV_API_KEY=
JEV_URL=https://api.typesafe.ai/v1/systemone
JEV_MODEL=jev-latest

# Reasoning plane
ANTHROPIC_API_KEY=

# In production read these from the macOS Keychain, not from a file:
